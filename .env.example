VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Reserved for future ATHENA reasoning backend.
VITE_ATHENA_API_BASE_URL=

# Match the Auth project's email OTP length (currently eight digits).
VITE_AUTH_OTP_LENGTH=8

# SERVER ONLY: configure these names in Supabase Edge Function Secrets.
# GOOGLE_GMAIL_CLIENT_ID
# GOOGLE_GMAIL_CLIENT_SECRET
# GMAIL_OAUTH_BOOTSTRAP_SECRET (independent random operator secret, at least 32 characters)
# OAuth refresh tokens are stored in Supabase Vault, never in an environment file.
# Reserved for Phase 15A-2; not required or used in Phase 15A-1:
# GCP_PROJECT_ID
# GMAIL_PUBSUB_TOPIC
# GMAIL_PUBSUB_PUSH_AUDIENCE
# GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT
